# ============================================================
# Aquilux POS (POS.V1) — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# Supabase project credentials
# Found in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application configuration
VITE_APP_NAME=Aquilux POS

# Development only — set to true to enable React Query Devtools
# Production / Cloudflare builds: set to false (or omit)
VITE_ENABLE_QUERY_DEVTOOLS=true

# ============================================================
# Local QA scripts only (scripts/*.mjs) — never commit real values
# ============================================================
QA_ADMIN_PASSWORD=
QA_CASHIER_PASSWORD=
QA_DEPOT_PASSWORD=
QA_PHASE11_FIXTURE_PASSWORD=
# Optional aliases used by specific scripts:
# CEO_NOTES_ADMIN_PASSWORD=  CEO_NOTES_CASHIER_PASSWORD=
# PHASE15A_ADMIN_PASSWORD=
